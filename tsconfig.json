{
    "compilerOptions": {
        "target": "esnext",
        "moduleResolution": "node",
        "module": "esnext",
        "strict": true,
        "alwaysStrict": true,
        // 配布物のビルドは tsup が行う。tsc は型検査だけに使う。
        "noEmit": true,
        "allowJs": false,
        "removeComments": false,
        "forceConsistentCasingInFileNames": true,
        "lib": [
            "DOM",
            "ESNext"
        ],
        "paths": {
            "~/*": ["./*"]
        }
    },
    "include": ["src"],
    "exclude": [
        "src/**/*.test.ts"
    ]
}
